{
  "info": {
    "name": "WA AI Tool — Backend",
    "description": "PingFlow / WA AI Tool backend API + WhatsApp webhook.\n\nSet the collection variables (baseUrl, verifyToken, phoneNumberId, metaAppSecret, authToken) under the collection's Variables tab or your environment.\n\n- baseUrl: http://localhost:4000  (or https://wa-tool-ai-builder-1.onrender.com)\n- verifyToken: the Verify Token saved in Settings (matches a connection's verifyToken)\n- phoneNumberId: the connected bot's Meta Phone Number ID (e.g. 135503427102513)\n- metaAppSecret: META_APP_SECRET on the server (only needed when WEBHOOK_VERIFY_SIGNATURE=true)\n- waFrom: the sender's WhatsApp id for simulated inbound messages\n- authToken: a JWT from Login (auto-set by the Login request's test script)\n- chatbotId: a chatbot id for the per-bot endpoints\n\nThe 'Webhook — Inbound (signed)' request computes a valid X-Hub-Signature-256 in a pre-request script, so it works whether signature verification is on or off.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "verifyToken", "value": "YOUR_VERIFY_TOKEN" },
    { "key": "phoneNumberId", "value": "135503427102513" },
    { "key": "metaAppSecret", "value": "dev_placeholder_secret" },
    { "key": "waFrom", "value": "919999999999" },
    { "key": "authToken", "value": "" },
    { "key": "chatbotId", "value": "" },
    { "key": "email", "value": "test@example.com" },
    { "key": "password", "value": "password123" }
  ],
  "item": [
    {
      "name": "Health & Keep-alive",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Ping (keep-alive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ping", "host": ["{{baseUrl}}"], "path": ["ping"] }
          }
        }
      ]
    },
    {
      "name": "WhatsApp Webhook",
      "item": [
        {
          "name": "Verify (GET handshake)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/webhook?hub.mode=subscribe&hub.verify_token={{verifyToken}}&hub.challenge=12345",
              "host": ["{{baseUrl}}"],
              "path": ["api", "whatsapp", "webhook"],
              "query": [
                { "key": "hub.mode", "value": "subscribe" },
                { "key": "hub.verify_token", "value": "{{verifyToken}}" },
                { "key": "hub.challenge", "value": "12345" }
              ]
            },
            "description": "Meta's verification handshake. Returns the challenge (12345) when verifyToken matches a connection; 403 otherwise; 400 if params are missing."
          }
        },
        {
          "name": "Inbound — Text (unsigned)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [{\n    \"id\": \"WABA_ID\",\n    \"changes\": [{\n      \"field\": \"messages\",\n      \"value\": {\n        \"messaging_product\": \"whatsapp\",\n        \"metadata\": { \"display_phone_number\": \"15556377648\", \"phone_number_id\": \"{{phoneNumberId}}\" },\n        \"contacts\": [{ \"profile\": { \"name\": \"Test User\" }, \"wa_id\": \"{{waFrom}}\" }],\n        \"messages\": [{\n          \"from\": \"{{waFrom}}\",\n          \"id\": \"wamid.TEST_TEXT\",\n          \"timestamp\": \"1700000000\",\n          \"type\": \"text\",\n          \"text\": { \"body\": \"hi\" }\n        }]\n      }\n    }]\n  }]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/whatsapp/webhook", "host": ["{{baseUrl}}"], "path": ["api", "whatsapp", "webhook"] },
            "description": "Simulates an inbound text message. Works when WEBHOOK_VERIFY_SIGNATURE=false. Always returns 200 (handler acks first); check server logs / conversation to confirm the workflow ran. phoneNumberId must match a connected bot."
          }
        },
        {
          "name": "Inbound — Image (unsigned)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [{\n    \"changes\": [{\n      \"field\": \"messages\",\n      \"value\": {\n        \"messaging_product\": \"whatsapp\",\n        \"metadata\": { \"phone_number_id\": \"{{phoneNumberId}}\" },\n        \"contacts\": [{ \"profile\": { \"name\": \"Test User\" }, \"wa_id\": \"{{waFrom}}\" }],\n        \"messages\": [{\n          \"from\": \"{{waFrom}}\",\n          \"id\": \"wamid.TEST_IMG\",\n          \"timestamp\": \"1700000000\",\n          \"type\": \"image\",\n          \"image\": { \"id\": \"MEDIA_ID_123\", \"mime_type\": \"image/jpeg\", \"caption\": \"my photo\", \"sha256\": \"abc\" }\n        }]\n      }\n    }]\n  }]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/whatsapp/webhook", "host": ["{{baseUrl}}"], "path": ["api", "whatsapp", "webhook"] },
            "description": "Simulates an inbound image message (tests the media-aware Question node). Stores a media reference as the answer."
          }
        },
        {
          "name": "Inbound — Text (signed)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Compute Meta's X-Hub-Signature-256 over the EXACT raw body using",
                  "// metaAppSecret, so this works when WEBHOOK_VERIFY_SIGNATURE=true.",
                  "const CryptoJS = require('crypto-js');",
                  "const body = pm.request.body.raw;",
                  "const secret = pm.collectionVariables.get('metaAppSecret');",
                  "const hash = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('xHubSig', 'sha256=' + hash);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Hub-Signature-256", "value": "{{xHubSig}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"object\":\"whatsapp_business_account\",\"entry\":[{\"changes\":[{\"field\":\"messages\",\"value\":{\"messaging_product\":\"whatsapp\",\"metadata\":{\"phone_number_id\":\"{{phoneNumberId}}\"},\"contacts\":[{\"profile\":{\"name\":\"Test User\"},\"wa_id\":\"{{waFrom}}\"}],\"messages\":[{\"from\":\"{{waFrom}}\",\"id\":\"wamid.TEST_SIGNED\",\"timestamp\":\"1700000000\",\"type\":\"text\",\"text\":{\"body\":\"hi\"}}]}}]}]}"
            },
            "url": { "raw": "{{baseUrl}}/api/whatsapp/webhook", "host": ["{{baseUrl}}"], "path": ["api", "whatsapp", "webhook"] },
            "description": "Same as the unsigned text request but with a valid HMAC signature auto-computed in the pre-request script. Use this to test against a server with WEBHOOK_VERIFY_SIGNATURE=true. metaAppSecret must equal the server's META_APP_SECRET. NOTE: the body here is single-line (minified) because the signature must match the exact bytes sent; keep it unformatted."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the JWT so other requests can use {{authToken}}.",
                  "try {",
                  "  const json = pm.response.json();",
                  "  const token = json.token || json.accessToken || (json.data && json.data.token);",
                  "  if (token) { pm.collectionVariables.set('authToken', token); console.log('authToken set'); }",
                  "} catch (e) { console.log('No JSON token in login response'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "On success, the test script stores the JWT into the authToken collection variable for all authenticated requests."
          }
        }
      ]
    },
    {
      "name": "Chatbots (JWT)",
      "item": [
        {
          "name": "List chatbots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/chatbots", "host": ["{{baseUrl}}"], "path": ["api", "chatbots"] }
          }
        },
        {
          "name": "Create chatbot",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"My Test Bot\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/chatbots", "host": ["{{baseUrl}}"], "path": ["api", "chatbots"] }
          }
        }
      ]
    },
    {
      "name": "Connection (JWT)",
      "item": [
        {
          "name": "Get connection",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/chatbots/{{chatbotId}}/connection", "host": ["{{baseUrl}}"], "path": ["api", "chatbots", "{{chatbotId}}", "connection"] }
          }
        },
        {
          "name": "Connection health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/chatbots/{{chatbotId}}/connection/health", "host": ["{{baseUrl}}"], "path": ["api", "chatbots", "{{chatbotId}}", "connection", "health"] }
          }
        },
        {
          "name": "Save connection (manual creds)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"businessName\": \"MyBusiness\",\n  \"phoneNumber\": \"+15556377648\",\n  \"phoneNumberId\": \"{{phoneNumberId}}\",\n  \"wabaId\": \"2587482161698326\",\n  \"accessToken\": \"PASTE_PERMANENT_TOKEN\",\n  \"verifyToken\": \"{{verifyToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/chatbots/{{chatbotId}}/connection", "host": ["{{baseUrl}}"], "path": ["api", "chatbots", "{{chatbotId}}", "connection"] },
            "description": "Saving with a valid accessToken + phoneNumberId verifies against Meta and sets status CONNECTED (or ERROR with a reason)."
          }
        }
      ]
    }
  ]
}
