# Copy this file to ".env" and fill in real values.
# The .env file is git-ignored and must NEVER be committed.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Matches the credentials in docker-compose.yml
DATABASE_URL="postgresql://wa_user:wa_password@localhost:5432/wa_ai_tool?schema=public"

# --- Auth ---
# Change this to a long random string. Used to sign JWT access tokens.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Frontend origin (for CORS) ---
FRONTEND_ORIGIN="http://localhost:3000"

# --- WhatsApp (filled in during Phase 4; kept backend-only) ---
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
